# Lab config for the desktop guest (virtio-gpu, KWin / GNOME / Sway sessions for captures).
# Create with: LAB_ENV=lab.desktop.env scripts/lab.sh up desktop ; other commands use lab.env.
. "$(dirname "${BASH_SOURCE[0]}")/lab.env"
LAB_RAM_MB=8192
LAB_DISK_GB=40
